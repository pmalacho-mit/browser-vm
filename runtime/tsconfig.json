{
  // The runtime: no VS Code, no DOM. Runs in a dedicated Web Worker (the
  // runtime frame, host/runtime-frame/) and in Node (the MCP server, tests, builders).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "webworker"]
  },
  "include": ["src/**/*.ts", "types/*.d.ts"]
}
