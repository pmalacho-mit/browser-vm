{
  // Build, dev and test scripts. They stay JavaScript (.mjs) and are type-checked
  // (checkJs) against Node's types. Strict, except that unannotated parameters
  // are allowed: wrong names, wrong arguments and misused APIs are errors;
  // missing annotations in test helpers are not.
  // The tests import browser code (web/gate, runtime/src/net.ts), hence "dom".
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "noImplicitAny": false
  },
  "include": ["*.mjs", "../types/**/*.d.ts"]
}
