# Kernel config fragment for the in-browser VM (applied on top of `make ARCH=i386 tinyconfig`).
# v86 emulates a single-CPU 32-bit x86 PC. Everything the guest needs is built in (=y),
# so no initramfs/modules are needed and ANY i386 container image can be used as rootfs.

# --- CPU / platform
CONFIG_M686=y
CONFIG_X86_TSC=y
CONFIG_HIGHMEM4G=y
CONFIG_NOHIGHMEM=n
CONFIG_SMP=n
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- basics userland expects
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=n
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_RD_GZIP=n
CONFIG_BLK_DEV_INITRD=n

# --- serial consoles: ttyS0 = terminal, ttyS1 = control channel
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
# COM1/COM3 share IRQ 4 and COM2/COM4 share IRQ 3
CONFIG_SERIAL_8250_EXTENDED=y
CONFIG_SERIAL_8250_SHARE_IRQ=y

# --- clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y

# --- virtio + 9p (the root filesystem lives in JavaScript and is served over virtio-9p)
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- boot speed (measured with scripts/boot-profile.mjs: cold boot 9.5 s → 4.9 s)
# Legacy BSD ptys: pty_init creates 256 pairs of device nodes, ~1 s in the
# emulator. Terminals use Unix98 ptys (/dev/pts, mounted by vm-init) instead.
CONFIG_LEGACY_PTYS=n
# No virtual consoles, keyboard or mouse: the VM is driven over serial ports.
# (The PS/2 mouse probe alone took 0.4 s.)
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_SERIO=n
# LZ4 decompresses several times faster than XZ, and decompression runs on the
# emulated CPU. The download grows by 0.3 MB (1.79 vs 1.49 MB gzipped), which
# costs far less than the decompression time it saves.
CONFIG_KERNEL_XZ=n
CONFIG_KERNEL_LZ4=y
