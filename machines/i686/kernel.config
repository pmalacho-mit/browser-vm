# 32-bit kernel for v86 (VM_ARCH=i686, the default). Applied after machines/kernel/common.config.
# v86 emulates a single-CPU i686 (Pentium III-class, SSE2/SSE3).
CONFIG_M686=y
CONFIG_HIGHMEM4G=y
CONFIG_NOHIGHMEM=n
CONFIG_PCI_GOANY=y
# The classic 32-bit-time system calls (futex, clock_gettime, nanosleep, ...).
# tinyconfig leaves them out, but userland still calls them: Go's runtime and
# V8's Abseil call futex(2) directly, which failed with ENOSYS without this
# (Go programs crashed; npm died with "Futex operation failed"). 64-bit
# kernels have these natively.
CONFIG_COMPAT_32BIT_TIME=y
