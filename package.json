{
  "name": "browser-linux-ide",
  "version": "0.1.0",
  "description": "VS Code (Code-OSS) + a Linux VM, running entirely client-side in the browser",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "build:x86_64": "node scripts/build-site.mjs --arch=x86_64",
    "dev": "node scripts/dev.mjs",
    "dev:x86_64": "node scripts/dev.mjs --arch=x86_64",
    "build:desolate": "IDE_URL=${DESOLATE_EXTERNAL_8080_URL:?port 8080 is not forwarded by desolate} GATE_URL=${DESOLATE_EXTERNAL_8081_URL:?port 8081 is not forwarded by desolate - rebuild the container} node scripts/build-site.mjs",
    "start": "node scripts/serve.mjs dist 8080 8081",
    "typecheck": "tsc -p extension && tsc -p web && tsc -p scripts",
    "guest": "guest/build-rootfs.sh",
    "guest:x86_64": "VM_ARCH=x86_64 guest/build-rootfs.sh",
    "kernel": "guest/build-kernel.sh",
    "kernel:x86_64": "VM_ARCH=x86_64 guest/build-kernel.sh",
    "test:boot": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/boot-test.mjs",
    "test:boot:x86_64": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/boot-test.mjs --arch=x86_64",
    "tls": "tls/build.sh",
    "test:gate": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gate-test.mjs",
    "profile:boot": "node scripts/boot-profile.mjs 128",
    "profile:boot:x86_64": "node scripts/boot-profile.mjs 128 --arch=x86_64",
    "compare:vm": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/compare-64.mjs",
    "compare:vm:x86_64": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/compare-64.mjs --arch=x86_64",
    "v86_64": "node scripts/fetch-v86_64.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.25.12",
    "v86": "^0.5.472",
    "vscode-web": "^1.91.1"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.91.0",
    "typescript": "^7.0.2"
  }
}
