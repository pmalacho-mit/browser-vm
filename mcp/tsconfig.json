{
  // The MCP server: Node, running the VM runtime in-process. It shares the
  // gate's policy code with the browser gate (web/gate/core.ts, config.ts).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"]
  },
  "include": ["*.ts", "../types/**/*.d.ts", "../web/globals.d.ts"]
}
